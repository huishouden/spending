{
  "name": "huishouden-spending",
  "private": true,
  "license": "PolyForm-Shield-1.0.0",
  "version": "2.8.3",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "bun test src apps-script",
    "script:status": "clasp show-file-status",
    "script:pull": "clasp pull",
    "script:push": "bun test apps-script && clasp push --force",
    "e2e": "playwright test e2e/smoke.spec.ts e2e/household.spec.ts e2e/inbox.spec.ts e2e/i18n.spec.ts",
    "e2e:signed-in": "playwright test e2e/signed-in.spec.ts",
    "prepare": "git config core.hooksPath .githooks",
    "screenshots": "playwright test e2e/screenshots.spec.ts",
    "env:pull": "gh variable list --json name,value -q '.[] | select(.name|startswith(\"VITE_\")) | \"\\(.name)=\\(.value)\"' > .env.local && echo 'wrote .env.local'",
    "e2e:emulator": "playwright test e2e/signed-in.spec.ts --grep-invert @staging"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase": "^12.19.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@google/clasp": "^3.4.1",
    "@huishouden/pwa-kit": "github:huishouden/pwa-kit#v0.98.0",
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^1.3.0"
  }
}
